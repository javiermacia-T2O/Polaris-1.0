{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polaris",
  "version": "0.1.0",
  "identifier": "com.medicionagil.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'" },
    "windows": [{
      "title": "Polaris",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true,
      "fullscreen": false,
      "backgroundColor": "#0b1f3a"
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../MedicionAgil_Light/dist/medicion-sidecar/": "sidecar/"
    },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}

