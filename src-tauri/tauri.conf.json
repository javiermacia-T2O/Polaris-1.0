{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polaris",
  "version": "0.1.0",
  "identifier": "com.medicionagil.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'" },
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Polaris",
        "width": 420,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": true,
        "backgroundColor": "#0b1f3a"
      },
      {
        "label": "main",
        "title": "Polaris",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b1f3a"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "sidecar-source/dist/medicion-sidecar/": "sidecar/"
    },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
